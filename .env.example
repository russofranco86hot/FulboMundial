# ============================================================================
# FulboMundial / Fulboy — Variables de Entorno (.env.example)
# Copiá este archivo a `.env.local` para desarrollo local.
# NUNCA subas `.env` o `.env.local` con credenciales reales a Git.
# ============================================================================

# ─── 1. URLs Canónicas de la Aplicación ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://fulbomundial.com.ar"
APP_URL="https://fulbomundial.com.ar"
NEXTAUTH_URL="https://fulbomundial.com.ar"
AUTH_TRUST_HOST="true"

# ─── 2. Base de Datos Serverless (Neon Postgres) ────────────────────────────
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── 3. Autenticación (NextAuth v5 + Google OAuth) ──────────────────────────
# Generar con: openssl rand -hex 32
AUTH_SECRET="reemplazar_con_cadena_aleatoria_de_64_caracteres"
AUTH_GOOGLE_ID="<TU_GOOGLE_CLIENT_ID>"
AUTH_GOOGLE_SECRET="<TU_GOOGLE_CLIENT_SECRET>"
ADMIN_PASSWORD="reemplazar_password_admin_respaldo"

# ─── 4. Pasarela Local: Mercado Pago (Checkout Pro + Webhooks) ──────────────
# Obtenelas en: https://www.mercadopago.com.ar/developers/panel/app
NEXT_PUBLIC_MP_PUBLIC_KEY="<TU_MP_PUBLIC_KEY>"
MP_ACCESS_TOKEN="<TU_MP_ACCESS_TOKEN>"
MP_WEBHOOK_SECRET="<TU_MP_WEBHOOK_SECRET>"
MP_USE_SANDBOX="false"
# Opcional: link de pago estático como fallback si aún no configuraste MP_ACCESS_TOKEN
NEXT_PUBLIC_MP_PRO_LINK=""

# ─── 5. Pasarela Internacional: Stripe (Checkout + Webhooks) ────────────────
# Obtenelas en: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<TU_STRIPE_PUBLISHABLE_KEY>"
STRIPE_SECRET_KEY="<TU_STRIPE_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="<TU_STRIPE_WEBHOOK_SECRET>"

# ─── 6. Configuración Comercial / Freemium PRO ──────────────────────────────
NEXT_PUBLIC_PRO_PRICE="$4.000 / mes"
NEXT_PUBLIC_PRO_WHATSAPP="5491100000000"
# Slugs de grupos separados por coma con acceso PRO bonificado (ej. grupo fundador)
PRO_WHITELIST_SLUGS="futbol-miercoles"

# ─── 7. Notificaciones Web Push (VAPID) y Cron Jobs ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@fulbomundial.com.ar"
CRON_SECRET="reemplazar_secreto_cron"
